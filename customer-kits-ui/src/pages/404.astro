  <main id="main" class="page-wrap section-pad min-h-[60vh]"><p class="eyebrow">404 / PAGE NOT FOUND</p><h1 class="mt-3 max-w-2xl text-5xl font-extrabold">This page didn’t connect.</h1><p class="mt-4 max-w-xl text-lg text-slate-600">The page may have moved. Start with our solutions or plan a walkthrough instead.</p><div class="mt-7 flex flex-wrap gap-3"><a class="btn btn-primary" href="/services">Explore solutions →</a><a class="btn btn-white" href="/">Return home</a></div></main>
</SiteLayout>
