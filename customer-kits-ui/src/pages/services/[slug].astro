---
import SiteLayout from '../../components/SiteLayout.astro';
import { services } from '../../../services.mjs';
export function getStaticPaths() { return services.map((service) => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
const title = service.seoTitle;
const description = service.description;
const related = service.related.map((slug) => services.find((item) => item.slug === slug)).filter(Boolean);
---
<SiteLayout title={title} description={description} path={`/services/${service.slug}`} service={service}>
  <main id="main">
    <section class="page-hero"><div class="page-wrap">
      <nav class="breadcrumb mb-6" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/services">Solutions</a><span aria-hidden="true">/</span><span aria-current="page">{service.title}</span></nav>
      <div class="service-detail-hero">
        <div><p class="eyebrow">{service.audience.map((item) => item === 'home' ? 'HOME' : 'BUSINESS').join(' + ')} / CUSTOM INTEGRATION</p><h1>{service.serviceName}</h1><p class="promise">{service.headline}</p><p class="intro">{service.intro}</p><a class="btn btn-primary mt-6" href={`/plan?interest=${service.slug}`}>Explore this for my space <span aria-hidden="true">→</span></a></div>
        <aside class="workflow-panel" aria-label="Illustrative workflow example"><p class="eyebrow">AN EXAMPLE WORKFLOW</p><h2 class="mt-2 text-xl font-bold">{service.example.name}</h2>
          <div class="workflow-row"><span class="when">WHEN</span><p><strong>The starting event</strong>{service.example.trigger}</p></div>
          <div class="workflow-row"><span class="when">IF</span><p><strong>The right conditions</strong>{service.example.condition}</p></div>
          <div class="workflow-row"><span class="when">THEN</span><p><strong>The connected response</strong>{service.example.actions.join(' · ')}</p></div>
          <p class="mt-3 rounded-lg bg-blue-50 p-3 text-sm font-semibold text-blue-900">{service.example.result}</p>
          <p class="workflow-note">Illustrative concept only. Exact equipment, supported controls and behavior are confirmed during project discovery.</p>
        </aside>
      </div>
    </div></section>

    <section class="page-wrap section-pad">
      <div class="details-grid">
        <article class="detail-box"><p class="eyebrow">WHO THIS HELPS</p><h2 class="mt-2">Designed around your use case.</h2><p>{service.whoFor}</p><p>Start with what the people in the space need to do. We’ll work through the equipment and design choices that support that outcome.</p></article>
        <article class="detail-box"><p class="eyebrow">SYSTEMS TO REVIEW</p><h2 class="mt-2">Connections we plan together.</h2><div class="connection-tags">{service.connections.map((item) => <span>{item}</span>)}</div><p class="text-sm">We confirm the exact models, permissions and available interfaces before committing to a specific integration.</p></article>
      </div>
    </section>

    <section class="bg-paper py-16 md:py-20" aria-labelledby="scope-title"><div class="page-wrap"><div class="section-heading"><div><p class="eyebrow">A CLOSER LOOK</p><h2 class="section-title" id="scope-title">What the design can cover.</h2></div><p class="section-copy">These are project areas to discuss and scope. Your proposal should list the exact equipment, services, dependencies and work included.</p></div>
      <div class="scope-grid">{service.scope.map(([name, detail], index) => <article class="scope-card"><span class="scope-index">DESIGN AREA / 0{index + 1}</span><h3>{name}</h3><p>{detail}</p></article>)}</div>
    </div></section>

    <section class="page-wrap section-pad"><p class="eyebrow">A STRONGER FIRST CONVERSATION</p><h2 class="section-title max-w-3xl">What we’ll learn before recommending a design.</h2><div class="discovery-list">{service.discovery.map((item) => <div class="discovery-item"><svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m4 10 4 4 8-8" /></svg><span>{item}</span></div>)}</div></section>

    <section class="bg-paper py-16 md:py-20" id="questions"><div class="page-wrap faq-grid"><div><p class="eyebrow">GOOD QUESTIONS</p><h2 class="section-title">Useful details, before you decide.</h2><p class="mt-4 max-w-sm text-slate-600">Bring your existing equipment and system details to the walkthrough. We’ll confirm possibilities before we promise an exact integration.</p></div><div class="faq-list">{service.questions.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>

    <section class="page-wrap section-pad"><div class="section-heading"><div><p class="eyebrow">RELATED SOLUTIONS</p><h2 class="section-title">Connected work, in context.</h2></div><a class="font-bold text-blue" href="/services">All services →</a></div><div class="grid gap-4 md:grid-cols-3">{related.map((item) => <a class="solution-card" href={`/services/${item.slug}`}><div class="card-top"><span class="system-icon text-xl" aria-hidden="true">{item.icon === 'home' ? '⌂' : item.icon === 'access' ? '◉' : item.icon === 'av' ? '◖' : item.icon === 'network' ? '⌁' : item.icon === 'business' ? '▦' : '↗'}</span></div><h3>{item.title}</h3><p>{item.short}</p><span class="card-link">Explore <span aria-hidden="true">→</span></span></a>)}</div></section>

    <section class="page-wrap pb-20"><div class="cta-panel"><div><p class="eyebrow">NEXT STEP</p><h2>Let’s map the idea to your space.</h2><p>Choose an on-site walkthrough or guided call with a visual demo. No package or predetermined system is assumed.</p></div><a class="btn btn-primary shrink-0" href={`/plan?interest=${service.slug}`}>Plan a walkthrough →</a></div></section>
  </main>
</SiteLayout>
